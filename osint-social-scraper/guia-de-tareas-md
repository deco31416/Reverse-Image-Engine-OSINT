5. Browser Service
// src/browser/browser.service.ts

import { Injectable, OnModuleDestroy } from '@nestjs/common';
import puppeteer, { Browser } from 'puppeteer';

@Injectable()
export class BrowserService implements OnModuleDestroy {
  private browser?: Browser;

  async getBrowser(): Promise<Browser> {
    if (!this.browser) {
      this.browser = await puppeteer.launch({
        headless: true,
        args: [
          '--no-sandbox',
          '--disable-setuid-sandbox',
          '--disable-dev-shm-usage',
          '--disable-gpu',
        ],
      });
    }

    return this.browser;
  }

  async newPage() {
    const browser = await this.getBrowser();
    const page = await browser.newPage();

    await page.setViewport({
      width: 1366,
      height: 768,
    });

    await page.setUserAgent(
      'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36',
    );

    return page;
  }

  async onModuleDestroy() {
    if (this.browser) {
      await this.browser.close();
    }
  }
}
6. Scraper GitHub inicial
// src/platforms/github/github.scraper.ts

import { Injectable } from '@nestjs/common';
import { SocialScraper } from '../social-scraper.interface';
import { SocialProfile } from '../../common/types';
import axios from 'axios';

@Injectable()
export class GithubScraper implements SocialScraper {
  platform = 'github' as const;

  async searchByUsername(username: string): Promise<SocialProfile[]> {
    try {
      const url = `https://api.github.com/users/${username}`;
      const { data } = await axios.get(url);

      return [
        {
          platform: 'github',
          name: data.name,
          username: data.login,
          profileUrl: data.html_url,
          avatarUrl: data.avatar_url,
          bio: data.bio,
          followers: data.followers,
          confidence: 0.95,
          capturedAt: new Date(),
        },
      ];
    } catch {
      return [];
    }
  }

  async searchByName(query: string, limit = 10): Promise<SocialProfile[]> {
    const url = `https://api.github.com/search/users?q=${encodeURIComponent(query)}&per_page=${limit}`;

    const { data } = await axios.get(url);

    return data.items.map((item) => ({
      platform: 'github',
      username: item.login,
      profileUrl: item.html_url,
      avatarUrl: item.avatar_url,
      confidence: 0.75,
      capturedAt: new Date(),
    }));
  }
}
