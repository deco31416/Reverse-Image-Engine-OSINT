8. Search Service
// src/search/search.service.ts

import { Injectable } from '@nestjs/common';
import { GithubScraper } from '../platforms/github/github.scraper';
import { SearchNameDto } from './dto/search-name.dto';
import { SearchUsernameDto } from './dto/search-username.dto';
import { SocialScraper } from '../platforms/social-scraper.interface';

@Injectable()
export class SearchService {
  private scrapers: SocialScraper[];

  constructor(private readonly githubScraper: GithubScraper) {
    this.scrapers = [githubScraper];
  }

  async searchByName(dto: SearchNameDto) {
    const platforms = dto.platforms ?? this.scrapers.map((s) => s.platform);

    const activeScrapers = this.scrapers.filter((scraper) =>
      platforms.includes(scraper.platform),
    );

    const results = await Promise.allSettled(
      activeScrapers.map((scraper) =>
        scraper.searchByName(dto.query, dto.limit ?? 10),
      ),
    );

    return results.flatMap((result) =>
      result.status === 'fulfilled' ? result.value : [],
    );
  }

  async searchByUsername(dto: SearchUsernameDto) {
    const platforms = dto.platforms ?? this.scrapers.map((s) => s.platform);

    const activeScrapers = this.scrapers.filter((scraper) =>
      platforms.includes(scraper.platform),
    );

    const results = await Promise.allSettled(
      activeScrapers.map((scraper) => scraper.searchByUsername(dto.username)),
    );

    return results.flatMap((result) =>
      result.status === 'fulfilled' ? result.value : [],
    );
  }
}
9. Controller
// src/search/search.controller.ts

import { Body, Controller, Post } from '@nestjs/common';
import { SearchService } from './search.service';
import { SearchNameDto } from './dto/search-name.dto';
import { SearchUsernameDto } from './dto/search-username.dto';

@Controller('api/v1/search')
export class SearchController {
  constructor(private readonly searchService: SearchService) {}

  @Post('name')
  searchByName(@Body() dto: SearchNameDto) {
    return this.searchService.searchByName(dto);
  }

  @Post('username')
  searchByUsername(@Body() dto: SearchUsernameDto) {
    return this.searchService.searchByUsername(dto);
  }
}
