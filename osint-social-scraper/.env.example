PORT=7110
NODE_ENV=development
ENABLE_SWAGGER=false

# Optional public URL used only for logs/docs. In Railway you can set this to your service URL.
# If omitted, Railway's RAILWAY_PUBLIC_DOMAIN is used when available, otherwise localhost.
SERVICE_PUBLIC_BASE_URL=http://localhost:7110

# Comma-separated origins or * for local testing.
CORS_ORIGIN=http://localhost:3003,http://localhost:7105

# If set, every protected /api/v1/* request must include x-api-key.
# SOCIAL_SCRAPER_API_KEY is the service-specific name; MICROSERVICES_API_KEY is kept as a shared fallback.
SOCIAL_SCRAPER_API_KEY=
MICROSERVICES_API_KEY=

# Redis Railway/local cache.
REDIS_URL=redis://localhost:6379
SOCIAL_CACHE_PREFIX=osint:social
SOCIAL_CACHE_TTL_SECONDS=600

# Mongo Railway/local persistence.
MONGODB_URI=
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Local: ./uploads
# Railway volume: /app/uploads
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:7110
BODY_LIMIT=10mb

# Provider keys for future platform-specific adapters.
# You can reuse RAPIDAPI_KEY from micro-ts-osint in Railway variables.
RAPIDAPI_KEY=
RAPIDAPI_KEY_FB_SCRAPER3=
RAPIDAPI_KEY_INSTAGRAM=
TIKTOK_RAPIDAPI_KEY=

# Own public profile crawler runs first for username/profile URL searches.
# RapidAPI is used only as a secondary enrichment/fallback layer.
PUBLIC_PROFILE_CRAWLER_ENABLED=true
PUBLIC_PROFILE_CRAWLER_TIMEOUT_MS=12000

# Optional RapidAPI provider wiring.
# Set host + paths for the specific RapidAPI product you choose.
# Supported placeholders in paths: {username}, {query}, {limit}
# Example shape only:
# INSTAGRAM_RAPIDAPI_HOST=instagram-provider.p.rapidapi.com
# INSTAGRAM_RAPIDAPI_USERNAME_PATH=/user/info?username={username}
# INSTAGRAM_RAPIDAPI_SEARCH_PATH=/search/users?query={query}&limit={limit}
INSTAGRAM_RAPIDAPI_HOST=
INSTAGRAM_RAPIDAPI_USERNAME_PATH=
INSTAGRAM_RAPIDAPI_SEARCH_PATH=

FACEBOOK_RAPIDAPI_HOST=
FACEBOOK_RAPIDAPI_USERNAME_PATH=
FACEBOOK_RAPIDAPI_SEARCH_PATH=

TIKTOK_RAPIDAPI_HOST=
TIKTOK_RAPIDAPI_USERNAME_PATH=
TIKTOK_RAPIDAPI_SEARCH_PATH=

RAPIDAPI_TIMEOUT_MS=15000

# Temporary image access (set a random secret in production)
UPLOAD_SIGNING_SECRET=
UPLOAD_URL_TTL_SECONDS=86400
PUPPETEER_EXECUTABLE_PATH=
