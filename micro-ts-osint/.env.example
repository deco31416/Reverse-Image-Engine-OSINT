# ==========================================
# OSINT MICROSERVICE - ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=7105
NODE_ENV=development
ENABLE_SWAGGER=false
ENABLE_TEST_UI=false

# Optional public URL used only for logs/docs. In Railway you can set this to your service URL.
# If omitted, Railway's RAILWAY_PUBLIC_DOMAIN is used when available, otherwise localhost.
SERVICE_PUBLIC_BASE_URL=http://localhost:7105

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3003

# HTTPS Redirect (production only)
HTTPS_REDIRECT_ENABLED=false

# Infrastructure
# Database Configuration (defaults to local MongoDB; no in-memory database fallback)
MONGODB_URI=mongodb://localhost:27017/ia-cam-osint
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
RETENTION_DAYS=30

# OSINT background jobs. Set REDIS_QUEUE_URL only if you want a separate Redis for queues.
OSINT_JOB_QUEUE_PREFIX=osint:jobs
OSINT_JOB_CONCURRENCY=1
OSINT_JOB_POLL_MS=1000
OSINT_JOB_MAX_ATTEMPTS=3
OSINT_JOB_RETRY_BACKOFF_MS=30000
OSINT_JOB_PROCESSING_TIMEOUT_MS=900000

# Face investigation jobs used by Rostros for long-running visual searches.
FACE_JOB_QUEUE_PREFIX=osint:face-jobs
FACE_JOB_CONCURRENCY=1
FACE_JOB_POLL_MS=1000
FACE_JOB_MAX_ATTEMPTS=2
FACE_JOB_RETRY_BACKOFF_MS=30000
FACE_JOB_PROCESSING_TIMEOUT_MS=1800000
FACE_JOB_IMAGE_TTL_HOURS=24
FACE_JOB_DELETE_TEMP_ON_COMPLETE=false

# ==========================================
# Security and Authentication
# ==========================================

# Required: app does not start without JWT secret
JWT_SECRET=

# Required for POST /api/v1/auth/login
OSINT_VALID_USERS=user@example.com
OSINT_AUTH_PASSWORD=

# Initial Mongo-backed Owner user. If auth_users is empty, the service seeds this account.
OSINT_INITIAL_OWNER_USERNAME=
OSINT_INITIAL_OWNER_EMAIL=admin@osint.local
OSINT_INITIAL_OWNER_PASSWORD=

# Public registration is not exposed. Prefer Owner-created users/invitations.
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_EXPOSE_RESET_URL_DEV=false
DASHBOARD_PUBLIC_URL=http://localhost:3003

# Optional local/staging demo users. Ignored in production.
AUTH_SEED_DEMO_USERS=false
AUTH_DEMO_USERS_CONFIRM=I_UNDERSTAND_LOCAL_ONLY
AUTH_DEMO_PASSWORD=

# Optional: internal auth between backend and this microservice
MICROSERVICES_API_KEY=

# ==========================================
# OSINT API KEYS
# ==========================================

# Google Custom Search API
# Get your API key: https://console.cloud.google.com/apis/credentials
# Get your CSE ID: https://programmablesearchengine.google.com/controlpanel/all
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Twitter API v2
# Get your bearer token: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# LinkedIn API
# Get your credentials: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook Graph API
# Get your token: https://developers.facebook.com/tools/accesstoken/
FACEBOOK_ACCESS_TOKEN=

# RapidAPI (Meta/Facebook OSINT - facebook-pages-scraper3 + social-media-scrape)
# Get your key: https://rapidapi.com/
RAPIDAPI_KEY=

# Instagram Graph API (requires Facebook App)
# Get your token: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3 (same as Google API key, but needs YouTube API enabled)
# Enable YouTube API: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ==========================================
# AI Services for Image Enhancement & Identification
# ==========================================

# Google Gemini API (for generating enhanced biometric images)
# Get your API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Groq API (for person identification from search results)
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional Groq key rotation (comma separated)
# GROQ_API_KEYS=key1,key2,key3
GROQ_STARTUP_PING_ENABLED=false

# Per-key daily limits
GROQ_TEXT_DAILY_LIMIT_PER_KEY=1000
GROQ_VISION_DAILY_LIMIT_PER_KEY=500

# Hugging Face API token
HUGGINGFACE_TOKEN=

# AI image processing tuning
GEMINI_IMAGE_TIMEOUT_MS=180000
HUGGINGFACE_IMAGE_TIMEOUT_MS=240000
HUGGINGFACE_IMAGE_MODELS=timbrooks/instruct-pix2pix,stabilityai/stable-diffusion-xl-base-1.0
HUGGINGFACE_CONDITIONED_ENABLED=true
HUGGINGFACE_IDENTITY_SCALE=1.1
HUGGINGFACE_CONTROLNET_SCALE=0.9

# Optional custom deployed endpoint (InstantID/IP-Adapter/ControlNet)
HUGGINGFACE_INFERENCE_ENDPOINT=

# ==========================================
# Search Engines
# ==========================================

# Bing Search
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Serper
SERPER_API_KEY=
SERPER_DAILY_LIMIT=400

# Tavily
TAVILY_API_KEY=

# Brave Search
BRAVE_SEARCH_API_KEY=

# ==========================================
# Image Storage
# ==========================================

# Set false to store images in local disk / Railway Volume instead of Cloudinary.
# Local development example:
# CLOUDINARY_ENABLED=false
# UPLOAD_DIR=./uploads
# UPLOAD_PUBLIC_BASE_URL=http://localhost:7105
#
# Railway Volume example:
# CLOUDINARY_ENABLED=false
# UPLOAD_DIR=/app/uploads
# UPLOAD_PUBLIC_BASE_URL=https://your-backend.railway.app
CLOUDINARY_ENABLED=true
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:7105
YANDEX_PERSIST_VISUAL_ASSETS=true
YANDEX_VISUAL_ASSET_LIMIT=12

# Cloudinary configuration (optional when CLOUDINARY_ENABLED=false)
# Get your credentials: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ia-cam/osint-searches

# ==========================================
# Datasec Proxy
# ==========================================

DATASEC_SERVICE_URL=http://localhost:7040
DATASEC_API_KEY=

# ==========================================
# Social Scraper Microservice (optional)
# ==========================================

# Local: run osint-social-scraper on port 7110
# Railway: point to the deployed social scraper service URL
SOCIAL_SCRAPER_BASE_URL=http://localhost:7110/api/v1
SOCIAL_SCRAPER_API_KEY=
SOCIAL_SCRAPER_TIMEOUT_MS=30000

# Face biometric microservice (OpenCV YuNet + SFace)
FACE_BIOMETRIC_BASE_URL=http://localhost:7120
FACE_BIOMETRIC_API_KEY=

# Visual context microservice (YOLO objects/person/context)
VISUAL_CONTEXT_BASE_URL=http://localhost:7130
VISUAL_CONTEXT_API_KEY=
VISUAL_CONTEXT_TIMEOUT_MS=30000

# ==========================================
# Web Crawler Configuration
# ==========================================

# Headless browser settings for web scraping
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT=30000
CRAWLER_MAX_PAGES=50

# User agent for web requests (to avoid being blocked)
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ==========================================
# Dark Web (optional)
# ==========================================

# Keep disabled unless Tor is running locally
DARKWEB_ENABLED=false
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050

# Temporary image access (set a random secret in production)
UPLOAD_SIGNING_SECRET=
UPLOAD_URL_TTL_SECONDS=86400
# Optional existing browser installation; otherwise use Puppeteer's browser cache.
PUPPETEER_EXECUTABLE_PATH=

# Password recovery delivery: configure SMTP or Resend and the sender address.
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
